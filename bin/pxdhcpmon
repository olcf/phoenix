#!/usr/bin/env python3

import sys
import traceback
import argparse
import threading
import phoenix
from pathlib import Path
import requests
import ipaddress
import threading
import subprocess
import time
from scapy.all import *
from phoenix.node import Node

# This is needed to turn off SSL warnings
from requests.packages.urllib3.exceptions import InsecureRequestWarning
requests.packages.urllib3.disable_warnings(InsecureRequestWarning)

# This disables scapy's exception eating
logging.getLogger("scapy.runtime").setLevel(logging.ERROR)

args = None
switchname_to_remoteid_machine = dict()
switchname_to_circuitid_m2h_function = dict()
remoteid_machine_to_switchname = dict()
switchport_to_node_interface = dict()
hpcm_nodes = None
hpcm_token = None
hpcm_sync_flag = None

def get_parser():
    parser = argparse.ArgumentParser(description="Phoenix DHCP monitoring utility")
    parser.add_argument('-v', '--verbose', action='count', default=0)
    parser.add_argument('-H', '--hpcm', action='store_true', default=False, help="Use HPCM instead of standalone")
    parser.add_argument('-c', '--cooldown', type=int, default=30, help="Time between dhcp updates")
    return parser

def main():
    global args

    parser = get_parser()
    args = parser.parse_args()

    Node.load_nodes()
    load_switches()
    load_nodes()

    if args.hpcm:
        load_hpcm_token()
        load_hpcm()
        threading.Thread(target=hpcm_sync, daemon=True).start()

    print("Starting DHCP Discover sniffer...")
    try:
        sniff(iface=get_working_ifaces(), filter="udp and (port 67 or port 68)", prn=packet_handler, store=0)
    except Exception as e:
        traceback.print_exc()
        sys.exit(1)

def hpcm_sync():
    global args
    global hpcm_sync_flag

    hpcm_sync_flag = threading.Event()
    print("Starting HPCM update thread with cooldown %d" % args.cooldown)
    
    while True:
        hpcm_sync_flag.wait()
        hpcm_sync_flag.clear()
        print("(((( Syncing HPCM ))))")
        subprocess.run(["/opt/clmgr/bin/cm", "node", "update", "config", "--sync", "dhcp", "-n", "admin"])
        time.sleep(args.cooldown)

def load_switches():
    global switchname_to_remoteid_machine
    global switchname_to_circuitid_m2h_function
    global remoteid_machine_to_switchname
    global switchport_to_node_interface

    for nodename,node in sorted(Node.nodes.items()):
        if 'type' not in node or node['type'] != 'switch':
            continue

        # Retrieve the remoteid settings
        try:
            (option82_format, option82_human, option82_machine) = node.option82_remoteid()
        except KeyError as e:
            print("%s" % e)
            continue

        switchname_to_remoteid_machine[nodename] = option82_machine
        remoteid_machine_to_switchname[option82_machine] = nodename

        try:
            circuitid_format = node['option82']['circuitid_format']
            if circuitid_format == 'integerbytes':
                switchname_to_circuitid_m2h_function[nodename] = from_big_bytes
            else:
                switchname_to_circuitid_m2h_function[nodename] = str
        except Exception as e:
            switchname_to_circuitid_m2h_function[nodename] = str
        
def from_little_bytes(val):
    return int.from_bytes(val, byteorder='little')

def from_big_bytes(val):
    return int.from_bytes(val, byteorder='big')

def load_nodes():
    for nodename,node in sorted(Node.nodes.items()):
        if 'interfaces' not in node:
            continue
        for ifacename,iface in node['interfaces'].items():
            if 'switch' not in iface:
                continue
            if 'switchport' not in iface:
                continue
            
            if 'bondmembers' in iface:
                if isinstance(iface['bondmembers'], list):
                    bondmembers = iface['bondmembers']
                else:
                    bondmembers = [iface['bondmembers']]
                bondmembers.append(ifacename)
                switchport_to_node_interface[(iface['switch'], iface['switchport'])] = (nodename, bondmembers)
            else:
                switchport_to_node_interface[(iface['switch'], iface['switchport'])] = (nodename, ifacename)

def load_hpcm_token():
    global hpcm_token
    hpcm_token = Path('/opt/clmgr/etc/.cli_token').read_text(encoding="utf-8")

def load_hpcm():
    global hpcm_nodes
    global hpcm_token

    url = "https://localhost:8080/cmu/v1/nodes"
    headers = {
        "X-Auth-Token": hpcm_token,
        "Accept": "application/json"
    }
    query_params = {
        "fields": "name,network.nics.macAddress,network.nics.name,network.nics.networkName,network.nics.bondingMaster,network.nics.links._self"
    }
    response = requests.get(url, headers=headers, params=query_params, verify=False)
    if response.status_code == 200:
        response_json = response.json()
        #hpcm_nodes = {node['name']: {nic: 'test' for nic in node['network']['nics']} for node in response_json}
        hpcm_nodes = { node['name']:
                         { iface['name']: 
                             {'mac': iface['macAddress'],
                              'network': iface['networkName'],
                              'bondmaster': iface['bondingMaster'],
                              'link': iface['links']['_self']
                             } for iface in node['network']['nics']
                         } for node in response_json
                     }
    else:
        print(f"Error {response.status_code}: {response.text}")

def match_node_interface(remoteid_machine, circuitid_machine):
    global remoteid_machine_to_switchname
    global switchname_to_circuitid_m2h_function
    global switchport_to_node_interface

    if remoteid_machine in remoteid_machine_to_switchname:
        switchname = remoteid_machine_to_switchname[remoteid_machine]
    else:
        raise KeyError("Unknown switch %s" % remoteid_machine)

    switchport = switchname_to_circuitid_m2h_function[switchname](circuitid_machine)

    if (switchname, switchport) in switchport_to_node_interface:
        (node, interface) = switchport_to_node_interface[(switchname, switchport)] 
    else:
        raise KeyError("Unknown switchport combo %s %s" % (switchname, switchport))

    return (node, interface)

def decode_opt82(raw_option82):
    i = 0
    remoteid = None
    circuitid = None

    while i < len(raw_option82):
        sub_opt_code = raw_option82[i]
        sub_opt_len = raw_option82[i+1]
        sub_opt_val = raw_option82[i+2:i+2+sub_opt_len]


        if sub_opt_code == 1:
            circuitid = sub_opt_val
        elif sub_opt_code == 2:
            remoteid = sub_opt_val
            
        i += sub_opt_len + 2 # Move to the next sub-option

    return(remoteid, circuitid)


def packet_handler(packet):
    global hpcm_nodes

    if not packet.haslayer(DHCP) or packet[DHCP].options[0][1] != 1:
        # Not a discover packet, ignore
        return

    bootp_mac = packet[BOOTP].chaddr[:6].hex(":")
    print(f"Captured DHCP Discover from {bootp_mac} via {packet[Ether].src}")
    
    raw_option82 = None
    for option in packet[DHCP].options:
        if isinstance(option, tuple):
            if option[0] == 82 or option[0] == 'relay_agent_information':
                raw_option82 = option[1]
                break
        elif isinstance(option, str) and option == "end":
            print("  No Option 82 found")
            return

    if raw_option82 is None:
        # Shouldn't get here unless there is a malformed packet
        print("  No Option 82 found")
        return

    try:
        remoteid, circuitid = decode_opt82(raw_option82)
    except:
        print(f"  decode_opt82 failed")
    
    if circuitid and remoteid:
        try:
            node, interface = match_node_interface(remoteid, circuitid)
            print("  Node %s interface %s" % (node, interface))
            if hpcm_nodes is not None:
                try_hpcm_update(node, interface, bootp_mac)
        except KeyError as e:
            print("  No match found - %s" % e)
            print(f"  Option 82 Remote ID: {remoteid}")
            if len(remoteid) == 4:
                print("  Option 82 Remote ID as an IP: %s" % ipaddress.IPv4Address(remoteid))
            print(f"  Option 82 Circuit ID: {circuitid}")
            if len(remoteid) == 4:
                print("  Option 82 Circuit ID as an integer: %s" % int.from_bytes(circuitid, byteorder='big'))
            pass
    else:
        print("  No Option 82 found or could not decode sub-options.")

def try_hpcm_update(node, interfaces, mac):
    global hpcm_nodes

    if node not in hpcm_nodes:
        print("  Node %s is not found in HPCM" % node)
        return
    if not isinstance(interfaces, list):
        interfaces = [interfaces]
    for interface in interfaces:
        iface = None
        if interface in hpcm_nodes[node]:
            iface = hpcm_nodes[node][interface]
        elif interface == 'bmc' and 'bmc0' in hpcm_nodes[node]:
            interface = 'bmc0'
            iface = hpcm_nodes[node][interface]
        else:
            ifacenames = [ ifacename for iface in hpcm_nodes[node] if 'bondmaster' in iface and iface['bondmaster'] == ifacename ]
            if len(ifacenames) == 1:
                interface = ifacenames[0]
                iface = hpcm_nodes[node][interface]
        if iface is None:
            print("  Node %s interface %s is not found in HPCM" % (node, interface))
            continue
        if iface['mac'] != mac:
            if hpcm_update(iface['link'], mac, node, interface):
                print("+++++++ Updated HPCM MAC %s to %s" % (iface['mac'], mac))
                # Update our internal representation so we don't hit cmdb repeatedly
                hpcm_nodes[node][interface]['mac'] = mac
        else:
            print("  MAC already set correctly in the HPCM database")
        return

def hpcm_update(link, mac, node, interface):
    global token
    global hpcm_nodes
    global hpcm_sync_flag
    
    url = "https://localhost:8080/cmu/v1/" + link
    headers = {
        "X-Auth-Token": hpcm_token,
        "Accept": "application/json"
    }
    payload = { 'macAddress': mac }

    try:
        response = requests.put(url, headers=headers, json=payload, verify=False)
    except Exception as e:
        print("  -- ERRROR updating HPCM %s" % e)
        return False

    if response.status_code == 200:
        # Flag the sync thread to update the dhcp config
        hpcm_sync_flag.set()
        return True
    else:
        print("  -- ERRROR updating HPCM: %s" % response.status_code)
        return False
    
if __name__ == '__main__':
    main()
